        <mxCell id="ELaOgfLHjAv01-ij8hZ_-29" value="Независимые кластеры Kubernetes в каждой зоне для изоляции отказов и соответствия RTO/RPO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;" vertex="1" parent="1">
